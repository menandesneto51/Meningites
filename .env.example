# Copie para `.env` e preencha. NÃO versione o arquivo `.env`.
# Este arquivo é só modelo — valores vazios / placeholders.

USE_SQLSERVER=true
USE_DW=true

# Opcional: reutilizar .env de outro projeto CIEVS (mesma infra DW)
# DW_ENV_FILE=C:\caminho\para\outro\.env

# ===== Data Warehouse SES/MT =====
DW_HOST=10.15.1.50
DW_PORT=1433
DW_DATABASE=Datawarehouse
DW_USER=
DW_PASSWORD=
DW_DRIVER=ODBC Driver 18 for SQL Server
DW_ENCRYPT=no
DW_TRUST_SERVER_CERTIFICATE=yes

# ===== Clima (Open-Meteo / OpenWeather) — apoio a correlação exploratória =====
USE_OPENMETEO=true
OPENWEATHER_API_KEY=

# ===== IA (Gemini OpenAI-compatible ou OpenAI) =====
USE_LLM_REPORT=true
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Alternativa OpenAI:
# OPENAI_API_KEY=
# MENINGITES_OPENAI_API_KEY=
# MENINGITES_OPENAI_MODEL=gpt-4o-mini

# Fonte SINAN: auto | dw | local
MENINGITES_SINAN_SOURCE=auto

# ===== [VACINAS] SI-PNI SES (servidor distinto do DW) =====
# Host 10.15.1.74 · BD Vacinas · view VW_Vacinas_PNI
# Senha vazia → o extrator reutiliza DW_PASSWORD
# Extrato preferencial: agregado município×ano×código (sem TOP) via módulo 19
SIPNI_MSSQL_HOST=10.15.1.74
SIPNI_MSSQL_PORT=1433
SIPNI_MSSQL_DATABASE=Vacinas
SIPNI_MSSQL_USER=menandesneto
SIPNI_MSSQL_PASSWORD=
SIPNI_MSSQL_VIEW=VW_Vacinas_PNI
SIPNI_MSSQL_DRIVER=ODBC Driver 18 for SQL Server
CIPV_DW_SCHEMA=dbo
CIPV_DW_TABLE=VW_Vacinas_PNI

# ===== RedCap / fila CIEVS (quase tempo real) — módulo 35 =====
# Stub offline-safe até existir export CIEVS de meningites.
